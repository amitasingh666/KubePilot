# Copy to deploy/.env and fill in. Used by docker-compose.prod.yml.

# Your domain (DNS A-record must point at this VM; Caddy gets HTTPS automatically).
DOMAIN=kubepilot.example.com

# Postgres superuser password (used for migrations). Pick something strong.
POSTGRES_PASSWORD=change-me-strong-postgres-pw

# Session cookie signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-64-hex-chars

# MinIO (object storage for reports/digests) credentials.
MINIO_ROOT_USER=kubepilot
MINIO_ROOT_PASSWORD=change-me-strong-minio-pw

# Optional — real email for digests (leave blank to just log them).
RESEND_API_KEY=

# NOTE: the app connects to Postgres as the `kubepilot_app` role with the password
# `app_password` (created by the migrations). To harden, after first boot run:
#   docker compose -f deploy/docker-compose.prod.yml exec postgres \
#     psql -U postgres -d kubepilot -c "ALTER ROLE kubepilot_app PASSWORD '<strong>';"
# and update APP_DATABASE_URL in the compose file to match.
