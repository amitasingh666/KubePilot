{
  "name": "kubepilot",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "infra:reset": "docker-compose down -v",
    "db:generate": "pnpm --filter @kubepilot/db generate",
    "db:migrate": "pnpm --filter @kubepilot/db migrate",
    "db:migrate:dev": "pnpm --filter @kubepilot/db migrate:dev",
    "db:seed": "pnpm --filter @kubepilot/db seed",
    "setup": "pnpm install && pnpm infra:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "prisma", "@prisma/client", "@prisma/engines"]
  }
}
