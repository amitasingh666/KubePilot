# ============================================================================
# KubePilot — local development environment (Phase 0)
# Copy to `.env` and adjust as needed:  cp .env.example .env
# ============================================================================

# --- Postgres / TimescaleDB -------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kubepilot
# Host port for the dev Postgres. Override if 5432 is already in use locally
# (then update the two URLs below to match). Container port is always 5432.
POSTGRES_PORT=5432

# Superuser URL — used ONLY for migrations / seeding (owns the schema, bypasses RLS).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kubepilot?schema=public

# App-role URL — used at RUNTIME by services. Non-superuser, so RLS is ENFORCED.
# The `kubepilot_app` role is created by the RLS migration.
APP_DATABASE_URL=postgresql://kubepilot_app:app_password@localhost:5432/kubepilot?schema=public

# --- Redis ------------------------------------------------------------------
# Two separate instances (per architecture): durable queue vs. cache/sessions.
REDIS_QUEUE_URL=redis://localhost:6379
REDIS_CACHE_URL=redis://localhost:6380

# --- Object storage (MinIO / S3-compatible) --------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kubepilot-reports
S3_REGION=us-east-1

# --- Backend ----------------------------------------------------------------
NODE_ENV=development
PORT=3001
