// KubePilot — Prisma schema (Phase 0 base model)
// Only the T1 base tables land here: tenant, app_user, membership, cluster.
// Later phases add inventory, usage (Timescale), recommendations, cost, etc.
//
// Tenant isolation is enforced by Postgres Row-Level Security, applied in a
// separate raw-SQL migration (Prisma cannot express RLS policies in-schema).
// See prisma/migrations/*_rls_and_extensions/migration.sql and src/client.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Superuser URL — used for migrate/generate/seed only (owns schema, bypasses RLS).
  // Runtime services override this with APP_DATABASE_URL (non-superuser → RLS enforced).
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  viewer
  finops
}

enum ClusterStatus {
  pending
  connected
  stale
  disconnected
  archived
}

enum WorkloadKind {
  deployment
  statefulset
  daemonset
  cronjob
  job
  replicaset
  rollout
}

model Tenant {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  dataRegion  String    @default("us") @map("data_region")
  billingPlan String?   @map("billing_plan")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  memberships Membership[]
  clusters    Cluster[]

  @@map("tenant")
}

model AppUser {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique
  name       String?
  idpSubject String?   @map("idp_subject")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("app_user")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      UserRole @default(viewer)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("membership")
}

model Cluster {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  name             String
  provider         String?
  region           String?
  distribution     String?
  autoscaler       String?
  prometheusFlavor String?       @map("prometheus_flavor")
  gitops           String?
  status           ClusterStatus @default(pending)
  lastSeenAt       DateTime?     @map("last_seen_at")
  agentVersion     String?       @map("agent_version")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime?     @updatedAt @map("updated_at")
  nodes              Node[]
  workloads          Workload[]
  autoscalers        Autoscaler[]
  pdbs               PodDisruptionBudget[]
  pvcs               Pvc[]
  services           K8sService[]
  ingestionSnapshots IngestionSnapshot[]
  credentials AgentCredential[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("cluster")
}

model Node {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  clusterId           String   @map("cluster_id") @db.Uuid
  name                String
  nodeGroup           String?  @map("node_group")
  instanceType        String?  @map("instance_type")
  capacityProvider    String?  @map("capacity_provider")
  cpuCapacityM        Int?     @map("cpu_capacity_m")
  memCapacityBytes    BigInt?  @map("mem_capacity_bytes")
  cpuAllocatableM     Int?     @map("cpu_allocatable_m")
  memAllocatableBytes BigInt?  @map("mem_allocatable_bytes")
  taints              Json?
  labels              Json?
  status              String?
  lastSeenAt          DateTime @default(now()) @map("last_seen_at")

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, name])
  @@index([tenantId])
  @@map("node")
}

model Workload {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  clusterId         String            @map("cluster_id") @db.Uuid
  namespace         String
  name              String
  kind              WorkloadKind
  replicas          Int?
  cpuRequestM       Int?              @map("cpu_request_m")
  memRequestBytes   BigInt?           @map("mem_request_bytes")
  cpuLimitM         Int?              @map("cpu_limit_m")
  memLimitBytes     BigInt?           @map("mem_limit_bytes")
  qosClass          String?           @map("qos_class")
  priorityClass     String?           @map("priority_class")
  managedBy         String            @default("none") @map("managed_by")
  gitopsOwned       Boolean           @default(false)  @map("gitops_owned")
  gitopsSource      Json?             @map("gitops_source")
  labels            Json?
  podLabels         Json?             @map("pod_labels")
  specHash          String?           @map("spec_hash")
  lastSeenAt        DateTime          @default(now()) @map("last_seen_at")
  archivedAt        DateTime?         @map("archived_at")
  containers ContainerSpec[]
  revisions  WorkloadRevision[]
  constraint SchedulingConstraint?
  recommendations Recommendation[]

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, namespace, name, kind])
  @@index([clusterId, namespace])
  @@index([managedBy])
  @@map("workload")
}

model ContainerSpec {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  workloadId      String  @map("workload_id") @db.Uuid
  container       String
  cpuRequestM     Int?    @map("cpu_request_m")
  cpuLimitM       Int?    @map("cpu_limit_m")
  memRequestBytes BigInt? @map("mem_request_bytes")
  memLimitBytes   BigInt? @map("mem_limit_bytes")

  workload Workload @relation(fields: [workloadId], references: [id], onDelete: Cascade)

  @@unique([workloadId, container])
  @@index([tenantId])
  @@map("container_spec")
}


model WorkloadRevision {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  workloadId      String  @map("workload_id") @db.Uuid
  observedAt      DateTime @default(now()) @map("observed_at")
  replicas        Int?
  cpuRequestM     Int?    @map("cpu_request_m")
  cpuLimitM       Int?    @map("cpu_limit_m")
  memRequestBytes BigInt? @map("mem_request_bytes")
  memLimitBytes   BigInt? @map("mem_limit_bytes")
  specHash        String? @map("spec_hash")

  workload Workload @relation(fields: [workloadId], references: [id], onDelete: Cascade)

  @@index([workloadId, observedAt]) 
  @@index([tenantId])
  @@map("workload_revision")
}

model SchedulingConstraint {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  workloadId     String  @unique @map("workload_id") @db.Uuid  // @unique → one-to-one
  nodeSelector   Json?   @map("node_selector")
  affinity       Json?
  antiAffinity   Json?   @map("anti_affinity")
  tolerations    Json?
  topologySpread Json?   @map("topology_spread")
  pvcAffinity    Json?   @map("pvc_affinity")

  workload Workload @relation(fields: [workloadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("scheduling_constraint")
}

model IngestionSnapshot {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  clusterId      String    @map("cluster_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  agentVersion   String    @map("agent_version")
  payloadKind    String    @map("payload_kind")
  status         String    @default("received")
  receivedAt     DateTime  @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, idempotencyKey])   // the dedupe key
  @@index([tenantId])
  @@map("ingestion_snapshot")
}


model Autoscaler {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  clusterId   String   @map("cluster_id") @db.Uuid
  workloadId  String?  @map("workload_id") @db.Uuid
  kind        String // hpa | vpa | keda
  minReplicas Int?     @map("min_replicas")
  maxReplicas Int?     @map("max_replicas")
  metric      String?
  target      Json?    @map("target_json")
  updateMode  String?  @map("update_mode")
  spec        Json?    @map("spec_json")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([clusterId])
  @@index([tenantId])
  @@map("autoscaler")
}

model PodDisruptionBudget {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  clusterId      String   @map("cluster_id") @db.Uuid
  namespace      String
  name           String
  minAvailable   String?  @map("min_available")
  maxUnavailable String?  @map("max_unavailable")
  selector       Json?    @map("selector_json")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, namespace, name])
  @@index([tenantId])
  @@map("pod_disruption_budget")
}

model Pvc {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  clusterId     String   @map("cluster_id") @db.Uuid
  namespace     String
  name          String
  storageClass  String?  @map("storage_class")
  capacityBytes BigInt?  @map("capacity_bytes")
  volumeType    String?  @map("volume_type")
  bound         Boolean?
  mounted       Boolean?
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, namespace, name])
  @@index([tenantId])
  @@map("pvc")
}

model K8sService {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  clusterId  String   @map("cluster_id") @db.Uuid
  namespace  String
  name       String
  type       String?
  hasTraffic Boolean? @map("has_traffic")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, namespace, name])
  @@index([tenantId])
  @@map("k8s_service")
}


model AgentCredential {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  clusterId  String   @map("cluster_id") @db.Uuid
  tokenHash  String   @map("token_hash")
  mtlsFingerprint  String?   @map("mtls_fingerprint")
  status     String   @default("active")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  @@unique([tokenHash])
  @@index([clusterId])
  @@index([tenantId])
  @@map("agent_credential")
}

model UsageMetricWorkload {
  tenantId    String   @map("tenant_id") @db.Uuid
  clusterId   String   @map("cluster_id") @db.Uuid
  workloadId  String   @map("workload_id") @db.Uuid
  ts          DateTime @db.Timestamptz(3)          // window end; timezone-aware
  windowSec   Int      @map("window_sec")
  cpuP95M     Int?     @map("cpu_p95_m")
  cpuAvgM     Int?     @map("cpu_avg_m")
  memMaxBytes BigInt?  @map("mem_max_bytes")        // MAX — for OOM-safe sizing
  memAvgBytes BigInt?  @map("mem_avg_bytes")
  restarts    Int      @default(0)

  @@id([workloadId, ts, windowSec])                 // composite PK incl. ts (Timescale requirement)
  @@index([tenantId])
  @@map("usage_metric_workload")
}


model UsageMetricNode {
  tenantId         String @map("tenant_id") @db.Uuid
  clusterId        String @map("cluster_id") @db.Uuid
  nodeId           String @map("node_id") @db.Uuid
  ts               DateTime @db.Timestamptz(3)  
  windowSec        Int @map("window_sec")
  cpuUsedM         Int? @map("cpu_used_m")
  memUsedBytes     BigInt? @map("mem_used_bytes") 
  cpuAllocPct      Float? @map("cpu_alloc_pct")
  memAllocPct      Float? @map("mem_alloc_pct")

  @@id([nodeId, ts, windowSec])
  @@index([tenantId])
  @@map("usage_metric_node")
}

model StabilityEvent {
  id         String   @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  clusterId  String   @map("cluster_id") @db.Uuid
  workloadId String?  @map("workload_id") @db.Uuid   // nullable: may not map to a workload
  ts         DateTime @db.Timestamptz(3)
  kind       String                                    // oomkill | restart | evicted | crashloop
  detail     Json?

  @@id([id, ts])                                        // surrogate id + ts (ts required by Timescale)
  @@index([tenantId])
  @@index([workloadId, ts])
  @@map("stability_event")
}
model Recommendation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  workloadId    String    @map("workload_id") @db.Uuid
  type          String                                  // cpu-rightsize | memory-rightsize
  resource      String                                  // cpu | memory
  unit          String                                  // millicores | bytes
  currentValue  BigInt    @map("current_value")         // BigInt holds both millicores and bytes
  proposedValue BigInt    @map("proposed_value")
  savings       BigInt
  confidence    String                                  // low | high
  status        String    @default("open")              // open | applied | dismissed
  rationale     String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  workload Workload @relation(fields: [workloadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workloadId])
  @@map("recommendation")
}
